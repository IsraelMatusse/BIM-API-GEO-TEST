# Copiar para .env e preencher. O .env esta no .gitignore.
# Carregar com:  set -a && source .env && set +a

export APP_PROFILE=dev
export SERVER_PORT=8282

# Base de dados
export DATABASE_NAME=bim_api_test_geo_db
export DATABASE_USER=postgres
export DATABASE_PASS=
export DATABASE_PORT=5432
export TIME_ZONE=Africa/Maputo
export DATABASE_URL=jdbc:postgresql://localhost:${DATABASE_PORT}/${DATABASE_NAME}?serverTimezone=${TIME_ZONE}

# Metadados e timeouts
export API_VERSION=1.0.0
export API_CONNECTION_TIMEOUT=10000
export API_CONNECTION_TIMEOUT_SECONDS=10

# Valores por omissao da pesquisa de geolocalizacao
export API_DEFAULT_GEO_COUNT=10
export API_DEFAULT_GEO_RESPONSE_FORMAT=json
export API_DEFAULT_GEO_LANGUAGE=pt

# Open-Meteo Geocoding API
export GEO_API_BASE_URL=https://geocoding-api.open-meteo.com
export GEO_API_SEARCH=/v1/search

# Open-Meteo Weather Forecast API
export WEATHER_API_BASE_URL=https://api.open-meteo.com
export WEATHER_API_FORECAST=/v1/forecast
